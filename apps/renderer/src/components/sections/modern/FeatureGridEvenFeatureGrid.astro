---
interface FeatureItem {
  iconUrl: string;
  headline: string;
  description: string;
}

interface Props {
  headline: string;
  subheadline: string;
  features: FeatureItem[];
  ctaText: string;
  ctaHref: string;
  imageUrl: string;
}

const { headline, subheadline, features = [], ctaText, ctaHref, imageUrl } = Astro.props;
---

<section data-eval-component="FeatureGridEvenFeatureGrid" class="feature-grid-even">
  <div class="container">
    <div class="content-wrapper">
      <div class="text-content">
        <h2 class="headline">{headline}</h2>
        <p class="subheadline">{subheadline}</p>
        <a href={ctaHref} class="button">{ctaText}</a>
      </div>
      <div class="image-wrapper">
        <img src={imageUrl} alt={headline} class="main-image" />
      </div>
    </div>
    <div class="features-grid">
      {features.map((feature) => (
        <div class="feature-item">
          <img src={feature.iconUrl} alt={feature.headline} class="feature-icon" />
          <h3 class="feature-headline">{feature.headline}</h3>
          <p class="feature-description">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-grid-even {
    padding-top: 0px;
    padding-bottom: 40px;
    background: linear-gradient(to right, #000000, #1a1a1a);
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding: 60px 20px;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-bottom: 60px;
    width: 100%;
  }

  .text-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .headline {
    font-family: "Poppins", sans-serif;
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .subheadline {
    font-family: "Inter", sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  .button {
    display: inline-flex;
    padding: 12px 24px;
    border-radius: 8px;
    background-color: #f76c00;
    color: #fff;
    font-family: "Inter", sans-serif;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .button:hover {
    background-color: #d45a00;
  }

  .image-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .main-image {
    width: 100%;
    max-width: 500px;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    width: 100%;
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 15px;
    padding: 20px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .feature-icon {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }

  .feature-headline {
    font-family: "Poppins", sans-serif;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
  }

  .feature-description {
    font-family: "Inter", sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  @media (min-width: 768px) {
    .content-wrapper {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .text-content {
      align-items: flex-start;
      text-align: left;
      flex: 1;
      max-width: 45%;
    }

    .image-wrapper {
      flex: 1;
      justify-content: flex-end;
    }

    .main-image {
      max-width: 100%;
    }

    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1440px) {
    .container {
      max-width: 1200px;
      padding: 90px 0;
    }

    .content-wrapper {
      gap: 80px;
      margin-bottom: 90px;
    }

    .text-content {
      gap: 30px;
    }

    .headline {
      font-size: 2.5rem;
    }

    .subheadline {
      font-size: 18px;
    }

    .button {
      padding: 16px 32px;
      font-size: 18px;
    }

    .main-image {
      max-width: 600px;
    }

    .features-grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 60px;
    }

    .feature-item {
      padding: 30px;
      gap: 20px;
    }

    .feature-icon {
      width: 70px;
      height: 70px;
    }

    .feature-headline {
      font-size: 24px;
    }

    .feature-description {
      font-size: 16px;
    }
  }
</style>
